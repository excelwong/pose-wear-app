<?xml version="1.0" encoding="utf-8"?>
<!-- 折叠屏展开 / 平板：左右双栏。
     左栏 3 个 tab（1.人物 / 2.服装 / 3.姿态），右栏 3 个 tab（4.生成 / 5.参数 / 6.设置）。
     两组 tab 完全同构：默认都选中第 0 个标签，其余标签为未选中状态。
     两边 tab 都用短文案 + tabMinWidth=0 + 小 padding + 小字号，一排紧凑放下。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/panel_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="衣姿工坊"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="折叠屏宽屏模式 · 左侧选素材，右侧生成"
            android:textSize="@dimen/text_small"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏：3 个素材 tab，默认选中第 0 个 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/tab_min_h"
                android:background="@color/panel_bg"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabMinWidth="0dp"
                app:tabPaddingStart="4dp"
                app:tabPaddingEnd="4dp"
                app:tabTextAppearance="@style/TabTextCompact"
                app:tabIndicatorHeight="2dp"
                app:tabIndicatorColor="@color/primary"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextColor="@color/text_secondary" />

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <!-- 右栏：与左栏同构的 3 个 tab，默认选中第 0 个「4.生成」 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/panel_bg">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/right_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/tab_min_h"
                android:background="@color/status_bg"
                android:saveEnabled="false"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabMinWidth="0dp"
                app:tabPaddingStart="4dp"
                app:tabPaddingEnd="4dp"
                app:tabTextAppearance="@style/TabTextCompact"
                app:tabIndicatorHeight="2dp"
                app:tabIndicatorColor="@color/primary"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextColor="@color/text_secondary" />

            <FrameLayout
                android:id="@+id/right_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/status_min_h"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_status"
        android:text="@string/status_ready"
        android:textSize="@dimen/text_small"
        android:textColor="@color/text_secondary"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
